<Window x:Class="FancyWM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FancyWMMainWindow"
        xmlns:res="clr-namespace:FancyWM.Resources"
        WindowStyle="None"
        Focusable="True"
        ShowInTaskbar="False"
        WindowState="Minimized">
    <Window.Resources>
        <ContextMenu x:Key="NotifierContextMenu" Placement="MousePoint">
            <MenuItem Header="{x:Static res:Strings.Settings}" Click="OnSettingsClick" />
            <MenuItem Header="{x:Static res:Strings.ErrorMessageBox_RestartFancyWM}" Click="OnRestartClick" />
            <MenuItem Header="{x:Static res:Strings.Quit}" Click="OnExitClick" />
        </ContextMenu>
    </Window.Resources>
</Window>
